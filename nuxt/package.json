{
  "name": "litteraturbanken-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "case-study:embed": "node scripts/embed-case-study.mjs",
    "lighthouse:reader": "node scripts/run-lighthouse-reader.mjs",
    "policy:check": "node scripts/verify-architecture-policy.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "quality:maintainability": "node scripts/run-maintainability.mjs",
    "quality:maintainability:update-baseline": "node scripts/run-maintainability.mjs --update-baseline",
    "quality:review:inventory": "node scripts/run-semantic-review.mjs inventory",
    "quality:review:queue": "node scripts/run-semantic-review.mjs queue",
    "quality:review:packet": "node scripts/run-semantic-review.mjs packet",
    "quality:review:record": "node scripts/run-semantic-review.mjs record",
    "quality:review:check": "node scripts/run-semantic-review.mjs check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:ssr": "playwright test --project=ssr",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:visual:capture": "playwright test --config=playwright.angular.config.ts",
    "test:visual:home:capture": "playwright test --config=playwright.home-angular.config.ts",
    "test:visual:presentations:capture": "playwright test --config=playwright.presentations-angular.config.ts",
    "test:visual:search:capture": "playwright test --config=playwright.search-angular.config.ts",
    "api:generate": "openapi-typescript \"${LBAPI_OPENAPI_SCHEMA:-http://127.0.0.1:8000/v2/openapi.json}\" --alphabetize --output app/lib/api/generated/lbapi.ts",
    "api:check": "openapi-typescript \"${LBAPI_OPENAPI_SCHEMA:-http://127.0.0.1:8000/v2/openapi.json}\" --alphabetize --check --output app/lib/api/generated/lbapi.ts"
  },
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "font-awesome": "4.4.0",
    "h3": "1.15.11",
    "htmlparser2": "10.1.0",
    "linkedom": "0.18.13",
    "nuxt": "4.4.8",
    "openapi-fetch": "0.17.0",
    "postcss": "8.5.6",
    "saxes": "6.0.0",
    "vue": "3.5.39",
    "vue-multiselect": "3.5.0",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.1",
    "@nuxt/eslint": "1.16.0",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-dom": "3.5.39",
    "@vue/compiler-sfc": "3.5.39",
    "@vue/server-renderer": "3.5.39",
    "autoprefixer": "10.4.21",
    "bootstrap-sass": "3.4.3",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-tailwindcss": "3.18.3",
    "knip": "6.32.0",
    "lighthouse": "13.4.1",
    "openapi-typescript": "7.13.0",
    "sass": "1.93.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
