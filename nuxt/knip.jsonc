{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "nuxt.config.ts",
    "app/app.vue",
    "app/pages/**/*.vue",
    "app/components/**/*.vue",
    "app/layouts/**/*.vue",
    "app/middleware/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "app/plugins/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "server/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
  ],
  "project": [
    "app/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}",
    "server/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "shared/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "!app/lib/api/generated/**"
  ],
  "ignore": [
    "app/lib/api/generated/**",
    ".nuxt/**",
    ".output/**",
    "coverage/**",
    "playwright-report/**",
    "test-results*/**",
    "test/**"
  ]
}
